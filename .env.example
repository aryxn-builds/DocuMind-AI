# ==================================================
# DocuMind AI — Environment Variables
# ==================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real credentials to Git.
# See SECURITY.md for the full secrets management policy.
# ==================================================


# --------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_ vars are
# exposed to the browser. Do not put secrets here.
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000


# --------------------------------------------------
# Backend (apps/api) — server-side only. Never
# expose these values to the browser.
# --------------------------------------------------

# Supabase (server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL — Supabase connection string
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# CORS — comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000

# --------------------------------------------------
# Qdrant (vector database)
# Local dev: http://localhost:6333 (via docker-compose)
# --------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=


# --------------------------------------------------
# LLM Providers
# --------------------------------------------------

# Groq — primary text LLM (https://console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini — vision + fallback LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama — optional local LLM (run: ollama serve)
OLLAMA_BASE_URL=http://localhost:11434


# --------------------------------------------------
# Langfuse (LLM Observability)
# https://cloud.langfuse.com or self-hosted
# --------------------------------------------------
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
LANGFUSE_HOST=https://cloud.langfuse.com


# --------------------------------------------------
# AI Configuration
# --------------------------------------------------
DEFAULT_LLM_PROVIDER=groq
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEFAULT_VISION_PROVIDER=gemini


# --------------------------------------------------
# Upload Limits (per docs/DECISION_LOG.md DEC-002)
# --------------------------------------------------
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg
