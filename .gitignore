# ==================================================
# DocuMind AI — .gitignore
# ==================================================

# --------------------------------------------------
# Environment variables & secrets (CRITICAL)
# --------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.sync.local
.envrc
*.pem
*.key

# --------------------------------------------------
# Node / Frontend (apps/web)
# --------------------------------------------------
node_modules/
.pnp
.pnp.js
.next/
out/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --------------------------------------------------
# Python / Backend (apps/api)
# --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
.venv/
venv/
env/
ENV/
.python-version
pip-log.txt
pip-wheel-metadata/
.cache/

# --------------------------------------------------
# Testing
# --------------------------------------------------
/coverage
.nyc_output
.pytest_cache/
.coverage
htmlcov/
.tox/
.noseids
.companion_devices/

# --------------------------------------------------
# Build artefacts
# --------------------------------------------------
*.egg-info/
*.log
cherrypy.log

# --------------------------------------------------
# IDEs & editors
# --------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.recommenders/

# --------------------------------------------------
# Operating System
# --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --------------------------------------------------
# Docker
# --------------------------------------------------
docker-compose.override.yml

# Misc
# --------------------------------------------------
*.db
*.sqlite3
*.log
.ruff_cache/

# Temp & scratch files
temp_token.txt
apps/web/temp_token.txt
profile_test.py
scratch_test.py
test_groq.py
test.pdf
test.png
apps/api/test_*.pdf
apps/api/rich_*.pdf
apps/api/create_test_user_and_link.py
apps/api/fix_data.py
